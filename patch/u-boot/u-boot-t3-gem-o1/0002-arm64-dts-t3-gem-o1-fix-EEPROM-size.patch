From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Toxpox <toxpox@outlook.com>
Date: Wed, 12 Aug 2026 17:10:00 +0300
Subject: [PATCH] arm64: dts: t3-gem-o1: describe the 64 KiB EEPROM

The board carries an AT24C512C. Describing it as an AT24C32 limits U-Boot
access to the first 4 KiB even though the complete 64 KiB device responds
at address 0x51.

Match the hardware-tested Linux device tree and expose the full EEPROM.

Signed-off-by: Toxpox <toxpox@outlook.com>
---
 dts/upstream/src/arm64/ti/k3-am67a-t3-gem-o1.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dts/upstream/src/arm64/ti/k3-am67a-t3-gem-o1.dts b/dts/upstream/src/arm64/ti/k3-am67a-t3-gem-o1.dts
index 8404b44e821..9079c20d860 100644
--- a/dts/upstream/src/arm64/ti/k3-am67a-t3-gem-o1.dts
+++ b/dts/upstream/src/arm64/ti/k3-am67a-t3-gem-o1.dts
@@ -456,7 +456,7 @@
 	};
 
 	eeprom@51 {
-		compatible = "atmel,24c32";
+		compatible = "atmel,24c512";
 		vcc-supply = <&vdd_3v3>;
 		reg = <0x51>;
 	};
--
2.39.5
